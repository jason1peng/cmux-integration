{
  "profile_id": "agy",
  "schema_version": 1,
  "capability_policy_version": 1,
  "capability_adapter": {
    "required": true,
    "version": 1,
    "discovery": ["local_skill_metadata", "mcp_metadata"],
    "request_transport": "profile-owned-transcript",
    "readiness": "supervisor-verifies-manifest-and-task-digests",
    "version_skew_reason": "capability-protocol-version-skew"
  },
  "launch": {
    "command": "${HOME}/bin/agy-with-permissions",
    "argv": [],
    "mode": "interactive",
    "permission_mode": "wrapper-declared-dangerous",
    "dangerous": true,
    "force": false,
    "yolo": false
  },
  "cwd": {
    "binding": "contract",
    "canonicalize": "pwd -P"
  },
  "probes": {
    "ready": {
      "kind": "screen",
      "description": "executor ready input prompt after banner and model line"
    },
    "idle": {
      "kind": "screen",
      "description": "executor returned to its ready input prompt after a turn"
    },
    "question": {
      "kind": "screen",
      "description": "executor asks for a consequential or routine decision"
    }
  },
  "transport": {
    "prompt": {
      "kind": "cmux-send",
      "requires_workspace": true,
      "requires_surface": true
    },
    "continuation": {
      "kind": "cmux-send",
      "requires_workspace": true,
      "requires_surface": true
    }
  },
  "transcript": {
    "source": "${HOME}/agi-result.txt",
    "kind": "post-invocation-hook-transcript",
    "hook": "agy-result-hook",
    "freshness": "supervisor mapping source.path/start_offset/launch_mtime_ns and result.path/start_offset/launch_mtime_ns are required; the hook accepts only the mapped canonical transcriptPath and reads complete bytes after the persisted source cursor; result/event evidence is staged in a durable pending transaction and the source cursor commits only after both sinks, with idempotent crash/replay recovery; reject stale, truncation, replacement, and unbound source identity"
  },
  "supervisor_mapping": {
    "required": true,
    "file": "${CMUX_AGENT_RUNTIME}/jobs/${job_nonce}/agy.mapping.json",
    "result_protocol": "agy-post-invocation-hook",
    "source_binding": "mapping source.path must equal the canonical hook transcriptPath; mapping result.path must equal ${HOME}/agi-result.txt",
    "exports": [
      "CMUX_AGENT_RUNTIME",
      "CMUX_AGENT_JOB_RUNTIME",
      "CMUX_AGENT_JOB_NONCE"
    ],
    "ownership": "supervisor-generated and supervisor-validated; job text, hook payloads, and pane text cannot override source or result identity"
  },
  "result": {
    "marker_rule": "nonce-framed-marker-in-same-fresh-appended-segment",
    "artifact_checks": [
      "expected artifact exists",
      "git diff --check",
      "declared focused checks pass"
    ],
    "idle_corroboration": true
  },
  "lifecycle": {
    "event": "PostInvocation",
    "source": "agy-result-hook",
    "hook_config": "${HOME}/.gemini/config/hooks.json",
    "hook_sink": "${CMUX_AGENT_RUNTIME}/events/agy-result.ndjson",
    "adapter": "${HOME}/bin/agy-hook-notify.sh",
    "hook_registration": "PostInvocation",
    "required": true,
    "acceptable_statuses": [
      "success",
      "completed",
      "ok"
    ],
    "failure_statuses": [
      "error",
      "aborted"
    ],
    "correlation": [
      "job_nonce",
      "executor_session",
      "workspace",
      "surface",
      "cwd",
      "transcript_source",
      "transcript_path",
      "source_start_offset",
      "source_offset",
      "transcript_offset"
    ],
    "deduplicate_by": [
      "event_id",
      "executor_session"
    ]
  },
  "stop": {
    "mode": "profile-command-with-explicit-surface",
    "deadline_seconds": 10
  }
}
