{
  "profile_id": "agy",
  "schema_version": 1,
  "launch": {
    "command": "agy",
    "argv": [],
    "mode": "headless",
    "input": "stdin",
    "permission_mode": "cli-default",
    "dangerous": false,
    "force": false,
    "yolo": false
  },
  "sandbox": "enabled",
  "network": "enabled",
  "write_scope": ["cwd"],
  "cwd": {
    "binding": "contract",
    "canonicalize": "pwd -P"
  },
  "result": {
    "format": "text",
    "completion": "process-exit-and-marker",
    "require_marker": true,
    "marker_rule": "the fresh stdout capture contains the job nonce followed by GOAL_COMPLETE; the calling agent verifies the artifact and does not trust this flag alone",
    "artifact_checks": [
      "expected artifact exists and has the requested contents",
      "git diff --check",
      "declared focused checks pass"
    ]
  },
  "timeout_seconds": 600,
  "stop": {
    "mode": "process-group",
    "deadline_seconds": 10
  }
}
